# Copy this file to .env and fill in the blanks. docker compose reads .env automatically.
# .env is git-ignored — never commit real secrets.

# Signing key for JWT access tokens. Generate a strong one:
#   openssl rand -base64 48
JWT_SECRET=

# Bootstrap admin, created the first time the API starts against an empty database.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# PostgreSQL. POSTGRES_PASSWORD is required; the others have defaults.
POSTGRES_DB=authdb
POSTGRES_USER=authuser
POSTGRES_PASSWORD=

# Host port the UI is served on (http://localhost:<WEB_PORT>).
WEB_PORT=8080
